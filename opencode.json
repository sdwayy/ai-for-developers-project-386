{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "mantine": {
        "type": "local",
        "command": ["npx", "-y", "@mantine/mcp-server"]
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest"]
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"]
      }
    }
  }
}