{
  "openapi": "3.0.0",
  "info": {
    "title": "Календарь звонков",
    "version": "1.0.0"
  },
  "tags": [],
  "paths": {},
  "components": {
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "enum": [
          "invalid-input",
          "unknown-event-type",
          "slot-unavailable",
          "slot-out-of-window",
          "event-type-in-use"
        ],
        "description": "Код ошибки API. Интерфейс отображает его в русский текст."
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ],
            "description": "Код ошибки."
          },
          "message": {
            "type": "string",
            "description": "Техническое сообщение об ошибке."
          }
        },
        "description": "Ответ с ошибкой. Поле message техническое и не показывается пользователю."
      },
      "EventType": {
        "type": "object",
        "required": [
          "id",
          "title",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Публичный идентификатор типа; генерируется сервером, в запросе на создание не принимается."
          },
          "title": {
            "type": "string",
            "maxLength": 100,
            "description": "Название типа встречи."
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "Описание типа встречи."
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 5,
            "maximum": 480,
            "description": "Длительность встречи в минутах."
          }
        },
        "description": "Тип встречи, выбираемый при бронировании. Публичный идентификатор генерирует сервер из названия."
      }
    }
  }
}
